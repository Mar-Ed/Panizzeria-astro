---
// Astro imports
import EmailIcon from "../svg/EmailIcon.astro";
import FacebookIcon from "../svg/FacebookIcon.astro";
import WhatsappIcon from "../svg/WhatsappIcon.astro";
import UbicIcon from "../svg/UbicIcon.astro";
import InstagramIcon from "../svg/InstagramIcon.astro";
---

<section class="contact-section wrapper">
  <div class="contact-container contact-main-box">
    <div class="contact-image contact-img-anim">
      <img src="/img/contact-img.png" alt="image" class="contact-img" />
    </div>
    <div class="contact-data">
      <h2 class="section-title">Contáctanos</h2>
      <div class="contact-info">
        <div class="container-1">
          <div class="writewe">
            <h3 class="contact-title">Escríbenos</h3>
            <div class="contact-social">
              <a
                href="https://api.whatsapp.com/send/?phone=51989286683&text&type=phone_number&app_absent=0"
                target="_blank"
                class="contact-social-link"
              >
                <div class="svg-container"><WhatsappIcon /></div>
              </a>
              <a
                href="https://www.facebook.com/LaPanizzeriadejose/"
                target="_blank"
                class="contact-social-link"
              >
                <div class="svg-container"><FacebookIcon /></div>
              </a>
              <a
                href="mailto:lapanizzeriadejose@gmail.com"
                target="_blank"
                class="contact-social-link"
              >
                <div class="svg-container"><EmailIcon /></div>
              </a>
              <a
                href="https://www.instagram.com/lapanizzeriaj/tagged/?hl=es-la"
                target="_blank"
                class="contact-social-link"
              >
                <div class="svg-container"><InstagramIcon /></div>
              </a>
            </div>
          </div>

          <div class="delivery-container">
            <h3 class="contact-title">Delivery</h3>
            <address class="contact-address">+51-989-286-683</address>
          </div>
        </div>

        <div class="contact-location">
          <h3 class="contact-title">Ubicación</h3>
          <div class="location-span">
            <span>LiMA - LURIN - PERU</span>
            <span>Peru Los Suspiros Mz.B Lt.8</span>
          </div>
          <a
            href="https://maps.app.goo.gl/KFhgjWUEVmteBoUz9"
            target="_blank"
            class="contact-map"
          >
            <div class="svg-container">
              <UbicIcon />
            </div>
            <span>Ver en el Mapa</span>
          </a>
        </div>
      </div>
    </div>

    <img src="/img/sticker-tomato.svg" alt="image" class="contact-sticker-1 sticker-float" />
    <img
      src="/img/sticker-mushroom.svg"
      alt="image"
      class="contact-sticker-2 sticker-float"
    />
    <img src="/img/sticker-onion.svg" alt="image" class="contact-sticker-3 sticker-float" />
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("load", () => {
    // Main container entry
    gsap.from(".contact-main-box", {
      scrollTrigger: {
        trigger: ".contact-section",
        start: "top 70%",
      },
      scale: 0.95,
      y: 100,
      opacity: 0,
      duration: 1.2,
      ease: "power3.out"
    });

    // Image entry
    gsap.from(".contact-img-anim", {
      scrollTrigger: {
        trigger: ".contact-section",
        start: "top 60%",
      },
      x: -50,
      opacity: 0,
      duration: 1.5,
      ease: "power2.out"
    });

    // Floating stickers
    gsap.to(".sticker-float", {
      y: 20,
      duration: 2,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      stagger: {
        amount: 1,
        from: "random"
      }
    });

    // Rotation for stickers
    gsap.to(".sticker-float", {
      rotation: 15,
      duration: 3,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      stagger: {
        amount: 1,
        from: "random"
      }
    });
  });
</script>

<style>
  .contact-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
  }

  .contact-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    position: relative;
    background-color: var(--container-color);
    padding: 3rem 2rem;
    border-radius: 3rem;
    max-width: 1200px;
    width: 100%;
    box-shadow: 0 15px 40px rgba(184, 115, 51, 0.1);
  }

  .container-1 {
    display: flex;
    flex-direction: row;
    justify-content: center; /* centra horizontalmente */
    gap: 4rem; /* espacio entre "Escríbenos" y "Delivery" */
    width: 100%;
  }

  .contact-data {
    padding-top: 3rem;
    flex: 1 1 350px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-title,
  .contact-title,
  .contact-address,
  .location-span {
    color: var(--first-color-dark);
    text-align: center;
  }

  .contact-info {
    display: flex;
    flex-direction: column; /* Aseguramos que sea columna */
    gap: 2rem; /* Espacio entre secciones principales */
  }

  .contact-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .contact-social-link {
    font-size: 1.5rem;
    color: var(--first-color);
    transition: transform 0.4s;
  }

  .contact-social-link:hover {
    transform: translateY(-0.25rem);
  }

  .contact-address {
    font-style: normal;
  }

  .location-span {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .contact-map {
    color: var(--first-color);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  .contact-map span {
    font-size: var(--small-font-size);
    font-weight: var(--font-semi-bold);
  }

  .contact-image {
    flex: 1 1 350px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .contact-img {
    max-width: 100%;
    width: 80%;
    height: auto;
    padding-top: 2.5rem;
  }

  .svg-container {
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    fill: var(--first-color);
  }

  .contact-sticker-1,
  .contact-sticker-2,
  .contact-sticker-3 {
    width: 3rem;
    position: absolute;
    opacity: 0.7;
    pointer-events: none;
  }

  .contact-sticker-1 {
    top: 2rem;
    left: 1rem;
  }

  .contact-sticker-2 {
    right: 1rem;
    bottom: 18rem;
  }

  .contact-sticker-3 {
    left: 5rem;
    bottom: 4rem;
  }

  .delivery-container {
    display: flex;
    flex-direction: column; /* Aseguramos que sea columna */
    align-items: center;
    gap: 1rem;
  }

  @media screen and (max-width: 816px) {
    .container-1 {
      flex-direction: column;
      align-items: center;
    }

    .writewe,
    .delivery-container {
      align-items: center;
      text-align: center;
    }

    .delivery-container {
      align-items: center;
    }
    .contact-container {
      flex-direction: column;
      padding: 3rem 1rem;
      border-radius: 0; /* Full bleed on mobile */
      max-width: 100%;
    }

    .contact-image {
      order: -1;
    }

    .contact-info {
      text-align: center;
    }

    .contact-img {
      max-width: 90%;
    }

    .contact-sticker-2 {
      bottom: 12rem;
    }
    .contact-location {
      display: flex;
      text-align: center;
      flex-direction: column;
      align-items: center;
    }
    .contact-sticker-3 {
      left: 1rem;
      bottom: 1rem;
    }
  }

  .contact-location {
    display: flex;
    flex-direction: column;
    align-items: center; /* ← CENTRA el contenido */
    text-align: center;
    gap: 0.5rem;
    padding-left: 0; /* Elimina padding que empuja a la izquierda */
  }

  .writewe {
    display: flex;
    flex-direction: column;
    align-items: center; /* centra iconos y textos */
    text-align: center;
    gap: 1rem;
  }

  .writewe,
  .delivery-container {
    flex: 1;
  }
</style>
