---
import Pizza from "../svg/Pizza.astro";
import Bar from "../svg/Bar.astro";
type Props = {
  type: string;
};

const links = [
  { name: "Home", url: "/" },
  { name: "Nosotros ", url: "/Nosotros" },
  { name: "Menu", url: "/Menu" },
];

//Numero de prueba para el carrito
const cost: string = "0.00";
---

<header class="navbar">
  <nav class="nav-container wrapper">
    <div class="text-logo">
      <Pizza />
      <div class="text-panizzeria">
        <span class="title">LA</span>
        <span class="title title-line">PANIZZERIA</span>
        <div class="subtitle-panizzeria">
          <span>PIZZAS Y PANES ARTESANALES</span>
        </div>
      </div>
    </div>

    <div class="container-links">
      {
        links.map((link) => (
          <a href={link.url}>
            <span>{link.name}</span>
            <div class="hover-transition" />
          </a>
        ))
      }
    </div>

    <!-- Sidebar Mobile -->
    <div class="side-bar" id="menu-btn">
      <div class="bar-sidebar">
        <Bar />
      </div>
      <div class="links-sidebar" id="mobile-menu">
        {
          links.map((link) => (
            <a href={link.url}>
              <span>{link.name}</span>
              <div class="hover-transition" />
            </a>
          ))
        }
      </div>
      <div class="overlay" id="overlay"></div>
    </div>
  </nav>
</header>
<script is:inline>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("active");
    });

    document.addEventListener("click", (e) => {
      if (!menuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenu.classList.remove("active");
      }
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("active");
      });
    });
  }
</script>
<script>
  const header = document.querySelector(".navbar");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });

  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("overlay");

  if (menuBtn && mobileMenu && overlay) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("active");
      overlay.classList.toggle("active");
    });

    overlay.addEventListener("click", () => {
      mobileMenu.classList.remove("active");
      overlay.classList.remove("active");
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("active");
        overlay.classList.remove("active");
      });
    });
  }
</script>

<style>
  .navbar {
    display: flex;
    position: fixed;
    z-index: 1000;
    width: 100%;
    height: 100px;
    justify-content: center;
    background: transparent;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar.scrolled {
    height: 80px;
    background: hsla(24, 86%, 88%, 0.9); /* Transparent body-color */
    backdrop-filter: blur(15px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .nav-container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    position: relative;
    max-width: 1200px;
  }

  .links-sidebar a {
    text-decoration: none;
    color: var(--nav-color);
  }

  .side-bar {
    display: none;
    width: 100%;
    justify-content: end;
    position: relative;
  }

  .links-sidebar {
    position: fixed;
    top: 0;
    right: -100%;
    width: 280px;
    height: 100vh;
    background-color: var(--body-color);
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    z-index: 1001;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);
  }

  .links-sidebar.active {
    right: 0;
  }

  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
  }

  .overlay.active {
    visibility: visible;
    opacity: 1;
  }

  .text-logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    transition: transform 0.3s ease;
  }

  .navbar.scrolled .text-logo {
    transform: scale(0.9);
  }

  .text-panizzeria {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .subtitle-panizzeria span {
    font-size: 0.65rem;
    font-weight: bold;
    color: var(--nav-color);
  }

  .title {
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 4px;
    color: var(--first-color); /* Set the whole phrase to the brand color */
    font-family: 'Carter One', cursive;
  }

  .title-line {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .container-links {
    display: flex;
    gap: 3rem;
  }

  .container-links a {
    text-decoration: none;
    color: var(--nav-color);
    font-weight: 700;
    position: relative;
    transition: color 0.3s ease;
  }

  .container-links a:hover {
    color: var(--first-color);
  }

  .hover-transition {
    position: absolute;
    bottom: -5px;
    left: 0;
    background-color: var(--first-color);
    width: 0%;
    height: 2px;
    transition: width 0.3s ease;
  }

  .container-links a:hover .hover-transition {
    width: 100%;
  }

  @media screen and (max-width: 768px) {
    .navbar {
      height: 70px;
    }
    .navbar.scrolled {
      height: 70px;
    }
    .container-links {
      display: none;
    }
    .side-bar {
      display: flex;
    }
    .subtitle-panizzeria {
      display: none;
    }
    .title {
      font-size: 1rem;
      letter-spacing: 2px;
    }
  }
</style>
