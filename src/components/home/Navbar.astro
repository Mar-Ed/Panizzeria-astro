---
import CartShopping from '../svg/CartShopping.astro'
import Pizza from '../svg/Pizza.astro'
import Bar from '../svg/Bar.astro'
import CostShop from '../react/CostShop'
type Props={
    type:string
}

const links=[
    {name:'Home',url:'/'},
    {name:'Nosotros ',url:'/Nosotros'},
    {name:'Menu',url:'/Menu'},
]

//Numero de prueba para el carrito
const cost:string="0.00"
---
<header class="navbar">
    <nav class="nav-container wrapper">
            <div class="text-logo">
                <Pizza/>
                <div class="text-panizzeria">
                    <span class="title">LA</span>
                    <span class="title"> PANIZZERIA</span>
                    <div class="bar-navbar">

                    </div>
                    <div class="subtitle-panizzeria">
                        <span>PIZZAS Y PANES ARTESANALES</span>
                    </div>
                </div>
            </div>
            <div class="container-links">
                {
                    links.map(link=>(
                        <a href={link.url} >
                            <span>{link.name}</span>
                            <div class="hover-transition">

                            </div>
                        </a>
                    ))
                }
            </div>
            <div class="shop-container">
                <div class="button-shop">
                    <CartShopping/>
                    <CostShop costShop={cost}/>
                </div>
            </div>
            <div class="side-bar">
                <div class="bar-sidebar">
                    <Bar class="qwe"></Bar>
                </div>
                <div class="links-sidebar">
                    {
                        links.map(link=>(
                            <a href={link.url} >
                                <span>{link.name}</span>
                                <div class="hover-transition">
                                
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
    </nav>
</header>
<style>
    .links-sidebar a{
        text-decoration: none;
        color: var(--nav-color);
    }

    .side-bar{
        height: 100%;
        display: flex;
        justify-content: center;
        padding-top: 0.75rem;
        padding-right: 1.5rem;
    }
    .links-sidebar{
        position: absolute;
        right: 0;
        top: 7rem;
        right: 1rem;
        background-color: var(--body-color);
        padding: 1rem;
        border-radius: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem   ;
    }
    .bar-sidebar{
        rotate: deg;
    }
    .text-logo{
        display: flex;
        align-items: center;
        gap: 0.50rem;
    }
    .text-panizzeria{
        display: flex;
        flex-direction: column;
        gap: 1px;
    }
    .bar-navbar{
        width: 100%;
        height: 1px;
        background-color: var(--body-color);
    }
    .subtitle-panizzeria span{
        font-size:0.74rem;
        font-weight: bold;
    }

    .subtitle-panizzeria span,.title{
        color: var(--body-color);
    }

    .title{
        font-weight: bold;
        letter-spacing: 5px;
    }


    .navbar{
        display: flex;
        width: 100%;
        height: 100px;
        justify-content: center;
        background: var(--nav-color);
    }

    .nav-container{
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        position: relative;
    }

     .img-link img{
        width: 200px;
        position: relative;
        top: 5px;
        
     }
     
     .container-links{
        display: flex;
        gap: 3rem;
     }

     .container-links a {
        text-decoration: none;
        color: var(--body-color);  
     }

     .button-shop{
        display: flex;
        align-items: center;
        gap: .5rem;
        color: var(--nav-color);
     }

     .shop-container{
        background-color: var(--body-color);
        padding: .5rem 1rem;
        border-radius: 2rem;
     }

     .hover-transition{
        background-color: antiquewhite;
        width: 0px;
        height: 0.10rem;
        transition: all 0.3s ease-in-out;
     }

     .container-links a:hover .hover-transition{
        width: 100%;
     }
     @media screen and (max-width: 720px) {
        .container-links,.shop-container {
            display: none;
        }
        
     }
</style>