---
import Pizza from "../svg/Pizza.astro";
import Bar from "../svg/Bar.astro";
import CartIcon from "../react/CartIcon";
type Props = {
  type: string;
};

const links = [
  { name: "Home", url: "/" },
  { name: "Nosotros ", url: "/Nosotros" },
  { name: "Menu", url: "/Menu" },
];

//Numero de prueba para el carrito
const cost: string = "0.00";
---

<header class="navbar">
  <nav class="nav-container wrapper">
    <a href="/" class="logo-link">
      <div class="text-logo">
        <Pizza />
        <div class="text-panizzeria">
          <span class="title">LA</span>
          <span class="title title-line">PANIZZERIA</span>
          <div class="subtitle-panizzeria">
            <span>PIZZAS Y PANES ARTESANALES</span>
          </div>
        </div>
      </div>
    </a>

    <div class="container-actions">
      <div class="container-links">
        {
          links.map((link) => (
            <a href={link.url}>
              <span>{link.name}</span>
              <div class="hover-transition" />
            </a>
          ))
        }
      </div>
      <CartIcon client:load />
    </div>

    <!-- Sidebar Mobile Trigger -->
    <div class="side-bar" id="menu-btn">
      <div class="bar-sidebar">
        <Bar />
      </div>
    </div>

    <!-- Sidebar Mobile Content (Outside trigger to avoid bubbling) -->
    <div class="links-sidebar" id="mobile-menu">
      {
        links.map((link) => (
          <a href={link.url}>
            <span>{link.name}</span>
            <div class="hover-transition" />
          </a>
        ))
      }
    </div>
    <div class="overlay" id="overlay"></div>
  </nav>
</header>
<script>
  const header = document.querySelector(".navbar");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });

  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("overlay");

  if (menuBtn && mobileMenu && overlay) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("active");
      overlay.classList.toggle("active");
    });

    overlay.addEventListener("click", () => {
      mobileMenu.classList.remove("active");
      overlay.classList.remove("active");
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("active");
        overlay.classList.remove("active");
      });
    });
  }

  // Logo Animation
  import gsap from "gsap";
  const logo = document.querySelector(".logo-link");
  if (logo) {
    logo.addEventListener("mouseenter", () => {
      gsap.to(logo, {
        scale: 1.05,
        duration: 0.4,
        ease: "expo.out"
      });
    });
    logo.addEventListener("mouseleave", () => {
      gsap.to(logo, {
        scale: 1,
        duration: 0.4,
        ease: "expo.out"
      });
    });
  }
</script>

<style>
  .navbar {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 4000;
    width: 100%;
    height: 100px;
    justify-content: center;
    background: transparent;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar.scrolled {
    height: 80px;
    background: rgba(248, 233, 217, 0.9); /* Semi-transparent var(--body-color) */
    backdrop-filter: blur(15px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .nav-container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    position: relative;
    max-width: 1200px;
  }

  .links-sidebar a {
    text-decoration: none;
    color: var(--nav-color);
  }

  .container-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .side-bar {
    display: none;
    align-items: center;
    gap: 1rem;
    position: relative;
    cursor: pointer;
    color: var(--nav-color); /* Ensure visibility */
  }

  .bar-sidebar {
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .side-bar:hover .bar-sidebar {
    transform: scale(1.1);
  }

  .links-sidebar {
    position: fixed;
    top: 0;
    right: -100%;
    width: 300px;
    height: 100vh;
    background: rgba(18, 12, 10, 0.95); /* Dark premium background */
    backdrop-filter: blur(15px);
    padding: 6rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    z-index: 6000;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -15px 0 45px rgba(0, 0, 0, 0.3);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .links-sidebar a {
    text-decoration: none;
    color: var(--white-color);
    font-size: 1.5rem;
    font-weight: 600;
    font-family: var(--second-font);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .links-sidebar a:hover {
    color: var(--first-color);
    transform: translateX(10px);
  }

  .links-sidebar.active {
    right: 0;
  }

  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(18, 12, 10, 0.4);
    backdrop-filter: blur(8px);
    z-index: 5000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.5s ease;
  }

  .overlay.active {
    visibility: visible;
    opacity: 1;
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .text-logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .navbar.scrolled .text-logo {
    transform: scale(0.9);
  }

  .text-panizzeria {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .subtitle-panizzeria span {
    font-size: 0.65rem;
    font-weight: bold;
    color: var(--nav-color);
  }

  .title {
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 4px;
    color: var(--first-color); /* Set the whole phrase to the brand color */
    font-family: 'Carter One', cursive;
  }

  .title-line {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .container-links {
    display: flex;
    gap: 3rem;
  }

  .container-links a {
    text-decoration: none;
    color: var(--nav-color);
    font-weight: 700;
    position: relative;
    transition: color 0.3s ease;
  }

  .container-links a:hover {
    color: var(--first-color);
  }

  .hover-transition {
    position: absolute;
    bottom: -5px;
    left: 0;
    background-color: var(--first-color);
    width: 0%;
    height: 2px;
    transition: width 0.3s ease;
  }

  .container-links a:hover .hover-transition {
    width: 100%;
  }

  @media screen and (max-width: 768px) {
    .navbar {
      height: 70px;
    }
    .navbar.scrolled {
      height: 70px;
    }
    .container-links {
      display: none;
    }
    .container-actions {
      gap: 1rem;
    }
    .side-bar {
      display: flex;
    }
    .subtitle-panizzeria {
      display: none;
    }
    .title {
      font-size: 1rem;
      letter-spacing: 2px;
    }
  }
</style>
