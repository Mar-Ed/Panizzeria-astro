---
import AmexIcon from "../svg/AmexIcon.astro";
import FacebookIcon from "../svg/FacebookIcon.astro";
import InstagramIcon from "../svg/InstagramIcon.astro";
import MastercadIcon from "../svg/MastercadIcon.astro";
import Pizza from "../svg/Pizza.astro";
import VisaIcon from "../svg/VisaIcon.astro";
import WhatsappIcon from "../svg/WhatsappIcon.astro";
---

<style>
  .footer-sponsor-input {
    border: none;
    background: transparent;
    flex: 1;
    width: 100%;
    color: var(--first-color-dark);
    font-weight: 500;
    padding: 0.5rem 0;
  }

  .footer-sponsor-input:focus {
    outline: none;
  }

  .footer-sponsor-input::placeholder {
    font-weight: 600;
    color: var(--text-color-light);
    opacity: 0.6;
  }

  .input-container {
    display: flex;
    align-items: center;
    padding: 0.3rem 0.3rem 0.3rem 1.2rem;
    background-color: var(--container-color);
    border-radius: 2rem;
    box-shadow: 0 4px 10px rgba(62, 39, 35, 0.1);
    width: 100%;
    max-width: 420px;
    border: 1px solid rgba(217, 34, 49, 0.12);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input-container:focus-within {
    box-shadow: 0 4px 15px rgba(217, 34, 49, 0.2);
    border-color: var(--first-color);
  }

  .btn-input {
    background-color: var(--first-color);
    border: none;
    padding: 0.7rem 1.5rem;
    border-radius: 2rem;
    color: var(--white-color);
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(217, 34, 49, 0.4);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-input:hover {
    background-color: var(--first-color-alt);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(217, 34, 49, 0.6);
  }

  .btn-input:active {
    transform: scale(0.98);
  }
</style>
<footer>
  <div class="wrapper">
    <div class="footer-header">
      <div class="text-logo">
        <div class="text-panizzeria">
          <span class="title title-center">LA</span>
          <span class="title title-line">PANIZZERIA</span>
          <div class="subtitle-panizzeria">
            <span>PIZZAS Y PANES ARTESANALES</span>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-menu">
      <div class="footer-column-section">
        <h2 class="footer-menu-title">Social</h2>
        <div class="footer-box-container">
          <a
            href="https://www.facebook.com/LaPanizzeriadejose/"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el Facebook oficial de La Panizzería de José"
          >
            <div class="svg-container-social">
              <FacebookIcon />
            </div>
          </a>
          <a
            href="https://www.instagram.com/lapanizzeriadejose/?hl=es-la"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el Instagram oficial de La Panizzería de José"
          >
            <div class="svg-container-social">
              <InstagramIcon />
            </div>
          </a>
          <a
            href="https://api.whatsapp.com/send/?phone=51989286683&text&type=phone_number&app_absent=0"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar por WhatsApp con La Panizzería"
          >
            <div class="svg-container-social">
              <WhatsappIcon />
            </div>
          </a>
        </div>
      </div>
      <div class="footer-sponsor-container">
        <h2 class="footer-menu-title">Subscribirse</h2>
        <p class="footer-sponsor-description">
          Recibe las últimas novedades y ofertas en tu correo electrónico.
        </p>
        <form class="input-container" action="#" method="POST" aria-label="Formulario de suscripción al boletín">
          <input
            type="email"
            id="footer-email"
            placeholder="Tu correo electrónico"
            class="footer-sponsor-input"
            required
            aria-required="true"
            aria-label="Correo electrónico para suscribirse"
          />
          <button type="submit" class="btn-input" aria-label="Suscribirse al boletín de novedades">
            Suscribirse
          </button>
        </form>
      </div>
      <div class="footer-column-section">
        <h2 class="footer-menu-title">Métodos de Pago</h2>
        <div class="footer-box-container">
          <div class="svg-container">
            <VisaIcon />
          </div>
          <div class="svg-container">
            <MastercadIcon />
          </div>
          <div class="svg-container">
            <AmexIcon />
          </div>
        </div>
      </div>
    </div>
    <p class="footer-copyright">
      © La Panizzeria. Todos los derechos reservados
    </p>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    margin-top: 5rem;
    padding: 4rem 0;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--first-color-dark);
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .footer-header {
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: column;
    width: 100%;
  }

  .title {
    color: var(--first-color);
    font-weight: bold;
    letter-spacing: 5px;
    font-size: 1.5rem;
  }

  .title-line {
    text-decoration-line: underline;
    text-underline-offset: 5px;
  }

  .title-center {
    text-align: center;
    padding-right: 1rem;
  }

  .text-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 60%;
    width: 60%;
  }

  .bar-footer {
    display: flex;
    height: 40%;
    width: 40%;
  }

  .text-panizzeria {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bar-footer {
    width: 100%;
    height: 1px;
    background-color: var(--first-color);
  }

  .subtitle-panizzeria span {
    font-size: 0.74rem;
    font-weight: bold;
  }

  .footer-menu {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 8rem;
  }

  .svg-container {
    width: 50px;
    height: 50px;
  }

  .footer-social-link {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-social-link:hover {
    transform: translateY(-5px);
  }

  .svg-container-social {
    width: 30px;
    height: 30px;
    fill: var(--first-color);
    transition: fill 0.3s ease;
  }

  .footer-social-link:hover .svg-container-social {
    fill: var(--first-color-alt);
  }

  .footer-column-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .footer-box-container {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-sponsor-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 420px;
  }

  .footer-social-text {
    text-decoration: none;
    color: var(--first-color);
  }

  .footer-sponsor-description {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--first-color-dark);
    text-align: center;
    line-height: 1.5;
    max-width: 340px;
    margin-bottom: 0.2rem;
  }

  .footer-copyright {
    text-align: left;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .footer-menu-title {
    color: var(--first-color-dark);
    font-weight: 100;
    font-size: var(--h2-font-size);
    font-family: var(--second-font);
  }

  @media screen and (max-width: 816px) {
    footer {
      padding-top: 3rem;
    }
    .footer-menu {
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }
    .footer-sponsor-container {
      width: 100%;
      max-width: 450px;
      padding: 0 1.5rem;
    }
  }
</style>
