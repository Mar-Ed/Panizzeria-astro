<div class="prin-container about-section">
    <div class="container">
        <div class="content about-content">
            <div class="contain-image about-image-box">
                <img src="img/about-img.png" alt="" />
            </div>
            <div class="content-right about-text-box">
                <div class="contain-text">
                    <p class="big-text title about-title">
                        Aprende acerca de Nuestra historia
                    </p>
                    <p class="about-description">
                        El secreto del éxito reside en los mejores ingredientes
                        para elaborar una pizza excepcional. Hoy buscamos la
                        perfección, tal como lo hemos hecho durante 15 años,
                        cuando abrimos la pizzería en Lima, Perú.
                    </p>
                </div>
                <div class="button-container about-cta">
                    <a href="/Nosotros" class="button">Conocenos</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("load", () => {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".about-section",
        start: "top 80%",
        toggleActions: "play none none none"
      }
    });

    tl.from(".about-image-box img", {
      scale: 0.8,
      opacity: 0,
      duration: 1.5,
      ease: "expo.out"
    })
    .from(".about-title", {
      y: 40,
      opacity: 0,
      duration: 1,
      ease: "expo.out"
    }, "-=1.2")
    .from(".about-description", {
      y: 30,
      opacity: 0,
      duration: 1,
      ease: "expo.out"
    }, "-=0.8")
    .from(".about-cta", {
      scale: 0.9,
      opacity: 0,
      duration: 0.8,
      ease: "back.out(1.7)"
    }, "-=0.6");

    // Continuous floating animation for the pizza board
    gsap.to(".about-image-box img", {
      y: -15,
      duration: 3,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut"
    });
  });
</script>

<style>
    .about-section {
        padding: 6rem 0;
        display: flex;
        justify-content: center;
    }
    .content {
        display: flex;
        align-items: center;
        gap: 4rem;
        max-width: 1200px;
        width: 100%;
        padding: 2rem;
    }

    .contain-image img {
        width: 500px;
        height: auto;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.15));
    }

    .contain-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .contain-text .big-text {
        font-size: 3.5rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-family: var(--second-font);
    }
    .contain-text p {
        margin-bottom: 2rem;
        font-size: 1.25rem;
        line-height: 1.8;
        color: var(--first-color-dark);
        max-width: 600px;
    }

    .button-container {
        display: flex;
    }
    .button {
        display: inline-flex;
        justify-content: center;
        background-color: var(--first-color);
        color: var(--white-color);
        padding: 1.2rem 2.5rem;
        font-size: 1.1rem;
        font-weight: 800;
        border-radius: 4rem;
        text-decoration: none;
        box-shadow: 0 10px 30px hsla(353, 100%, 40%, 0.3);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);

        &:hover {
            background-color: var(--first-color-dark);
            transform: translateY(-5px);
            box-shadow: 0 15px 40px hsla(353, 100%, 40%, 0.4);
        }
    }

    @media (max-width: 768px) {
        .content {
            flex-direction: column;
            text-align: center;
        }

        .contain-image img {
            width: 100%;
            max-width: 300px;
        }
    }
</style>
