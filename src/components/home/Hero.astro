<section class="hero-section">
  <div class="container hero-container">
    <div class="text-container">
      <h1 class="title hero-title">La Panizzeria</h1>
      <p class="subtitle hero-subtitle">
        Desde 1985, La Panizzeria ha sido el hogar de las mejores pizzas
        artesanales, combinando tradición italiana con sabores locales únicos.
      </p>
      <div class="hero-cta">
        <a href="/Menu" class="button">Descubre nuestras pizzas</a>
      </div>
    </div>
    <div class="image-container hero-image-box">
      <div class="hero-image-wrapper">
        <img
          src="/img/panizzeria-fondo.jpg"
          alt="Pizza Hero"
          class="hero-image"
        />
        <div class="hero-frame"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  window.addEventListener("load", () => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // Entry animation
    tl.from(".hero-title", {
      y: 100,
      opacity: 0,
      duration: 1.2,
      delay: 0.2,
    })
      .from(
        ".hero-subtitle",
        {
          y: 50,
          opacity: 0,
          duration: 1,
        },
        "-=0.8"
      )
      .from(
        ".hero-cta",
        {
          y: 30,
          opacity: 0,
          duration: 0.8,
        },
        "-=0.6"
      )
      .from(
        ".hero-image-box",
        {
          scale: 0.8,
          opacity: 0,
          duration: 1.5,
          ease: "elastic.out(1, 0.75)",
        },
        "-=1.2"
      );

    // Hover animation
    const wrapper = document.querySelector(".hero-image-wrapper");
    const img = document.querySelector(".hero-image");
    const frame = document.querySelector(".hero-frame");

    if (wrapper && img && frame) {
      wrapper.addEventListener("mouseenter", () => {
        gsap.to(img, {
          scale: 1.08,
          duration: 0.6,
          ease: "power2.out",
        });
        gsap.to(frame, {
          opacity: 1,
          scale: 1.02,
          borderWidth: "4px",
          duration: 0.4,
          ease: "back.out(2)",
        });
      });

      wrapper.addEventListener("mouseleave", () => {
        gsap.to(img, {
          scale: 1,
          duration: 0.6,
          ease: "power2.inOut",
        });
        gsap.to(frame, {
          opacity: 0,
          scale: 0.95,
          borderWidth: "0px",
          duration: 0.4,
          ease: "power2.inOut",
        });
      });
    }
  });
</script>

